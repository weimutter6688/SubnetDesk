[Unit]
Description=SubnetDesk
Requires=network.target
After=systemd-user-sessions.service

[Service]
Type=simple
ExecStart=/usr/bin/subnetdesk-weimutter6688 --service
ExecStop=/usr/bin/pkill -f "subnetdesk-weimutter6688 --"
PIDFile=/run/subnetdesk-weimutter6688.pid
KillMode=mixed
TimeoutStopSec=30
User=root
LimitNOFILE=100000
Environment="PULSE_LATENCY_MSEC=60" "PIPEWIRE_LATENCY=1024/48000"

[Install]
WantedBy=multi-user.target
